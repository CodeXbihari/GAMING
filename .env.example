# .env example for Hostel Gaming Hub backend
# -------------------------------------------------
# Supabase public credentials (used in the frontend)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase service role key (used ONLY by Edge Functions / server‑side code)
# **Never** commit this key to version control.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email notifications – using Gmail SMTP (free) or a SendGrid API key if you later install the plugin.
# For Gmail you need an App Password (if 2‑FA enabled) or OAuth token.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-or-oauth-token

# Optional: SendGrid API key if you decide to switch to SendGrid later.
# SENDGRID_API_KEY=your-sendgrid-key

# UPI details (admin‑provided, never secret)
UPI_ID=your-upi-id@upi
QR_CODE_BUCKET=ui-assets   # bucket where the QR code image is stored

# Signed URL TTL for payment proof access (in seconds)
PROOF_URL_TTL=600   # 10 minutes

# Misc configuration
CACHE_MAX_AGE=300   # seconds, for any client‑side caching you might add
